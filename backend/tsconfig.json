{
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.tsx"
                ],
    "exclude":  [
                    "node_modules"
                ],
    "compilerOptions":  {
                            "noEmit":  true,
                            "baseUrl":  ".",
                            "strict":  true,
                            "module":  "esnext",
                            "incremental":  true,
                            "moduleResolution":  "bundler",
                            "isolatedModules":  true,
                            "skipLibCheck":  true,
                            "allowJs":  true,
                            "target":  "es5",
                            "resolveJsonModule":  true,
                            "esModuleInterop":  true,
                            "paths":  {
                                          "@/app/types/*":  [
                                                                "../frontend/app/types/*"
                                                            ],
                                          "@/app/api/action/*":  [
                                                                     "./src/actions/*"
                                                                 ],
                                          "@/*":  [
                                                      "./src/*"
                                                  ]
                                      },
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "jsx":  "preserve",
                            "types":  [
                                          "node"
                                      ]
                        }
}
